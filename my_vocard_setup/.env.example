# Deploy checklist:
# 1. Copy this file to `.env` and replace every YOUR_* placeholder.
# 2. Rotate YT_CIPHER_API_TOKEN and CLOUDFLARED_TOKEN if they were ever committed
#    in git history (removing them from the tree does not revoke them).
# 3. Lavalink reads REMOTE_CIPHER_URL / YT_CIPHER_API_TOKEN / IP_BLOCKS with empty
#    defaults — leave them blank and YouTube playback fails quietly. Set real values.
# 4. Reboot the bot once after deploy so slash commands (e.g. /whitelist) sync.

# Bot (settings.json can override; these are fallbacks)
TOKEN=YOUR_BOT_TOKEN
CLIENT_ID=YOUR_BOT_CLIENT_ID
GENIUS_TOKEN=YOUR_GENIUS_TOKEN
# Used by docker-compose for the vocard service (env_file + compose defaults)
MONGODB_URL=mongodb://mongo:27017
MONGODB_NAME=vocard

# Lavalink YouTube plugin (required for YouTube; empty = soft failure at runtime)
YOUTUBE_OAUTH_REFRESH_TOKEN=
YOUTUBE_POT_TOKEN=
YOUTUBE_POT_VISITOR_DATA=

# IP: set IP_PREFERENCE for intent, then copy matching defaults into HOST/URL.
# ipv4 -> YT_CIPHER_HOST=0.0.0.0  REMOTE_CIPHER_URL=http://127.0.0.1:8001
# ipv6/dual -> YT_CIPHER_HOST=::  REMOTE_CIPHER_URL=http://[::1]:8001
IP_PREFERENCE=ipv6
IP_BLOCKS=YOUR_CIDR_BLOCK
YT_CIPHER_HOST=::
REMOTE_CIPHER_URL=http://[::1]:8001
YT_CIPHER_API_TOKEN=YOUR_YT_CIPHER_API_TOKEN

# Cloudflare tunnel
CLOUDFLARED_TOKEN=YOUR_CLOUDFLARED_TOKEN
